#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>
#include <string.h>


int main (){
    FILE *file;
    char line[1024];
    int Total =0 ;
    char str1[100];
    char str2[100];
    char str3[200];
    int num;




    file = fopen("document.txt", "r");
    if (file == NULL) {
        printf("file can't be opened.\n");
    return 1;
}
    while (fgets(line, sizeof(line), file)) {
            int len = strlen(line);


            for (int i = 0; line[i] != '\0'; i++) {
                 if (isdigit(line[i])){
                    str1[0] = line[i];
                    break;
                 }
                 
            }
            for (int i = len - 1; i >= 0; i--) {
                if (isdigit(line[i])){
                    str2 [0]= line[i];
                    break;
                    }
                 
                 }
                 strcpy(str3, str1);  
                 strcat(str3, str2);
                 num = atoi(str3);     
                 Total=Total+num;

    
}
    fclose(file);
        printf("le somme est: %d\n", Total);

    return 0;
}
